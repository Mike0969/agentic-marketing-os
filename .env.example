NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Lets token-triggered agent runs (Hermes/n8n) write + read agent
# observability past RLS. NEVER prefix with NEXT_PUBLIC. Leave blank to require
# an admin browser session for persistence.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only migration runner options. Prefer SUPABASE_ACCESS_TOKEN for the
# Supabase Management API, or SUPABASE_DB_URL for direct psql execution.
# Never prefix these with NEXT_PUBLIC.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
SUPABASE_SQL_RPC=

# Optional local bootstrap for the first admin account.
# In production, add the same email to public.admin_users.
ADMIN_EMAIL=

# Later agent integrations
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_MS=180000
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
HERMES_AGENT_ENDPOINT=
HERMES_AGENT_TOKEN=
HERMES_AGENT_MODEL=gpt-5.5
HERMES_AGENT_BACKUP_MODEL=
HERMES_AGENT_TIMEOUT_MS=120000
# Optional: local Hermes team registry + shared brain (Agent Brain page reads these).
# Defaults to the buddy profile path when unset. team.json points to its own brain dir.
HERMES_TEAM_PATH=
HERMES_BRAIN_PATH=
# Bearer token so Hermes / n8n / Telegram can call the team trigger endpoints
# (/api/agents/team/run and /report) without a browser session. Leave blank to
# require an admin session only.
AGENT_TRIGGER_TOKEN=
LEAD_FORM_TOKEN=
N8N_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
LINKEDIN_ACCESS_TOKEN=
X_API_KEY=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
# Read-only Search Console connector (first analytics integration), PER BRAND.
# All values server-only. Never NEXT_PUBLIC. Read-only scope, no posting.
#
# DURABLE AUTH (recommended): a service account with the webmasters.readonly
# scope, added as a USER on each Search Console property. Self-mints tokens, no
# manual refresh. Provide ONE shared service account (covers both brands once it
# is added to both properties) OR per-brand. Use a file path or inline JSON.
GOOGLE_APPLICATION_CREDENTIALS=        # path to the service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY=            # OR the service-account JSON as an inline string
# Optional per-brand service accounts (only if not sharing one):
# GOOGLE_APPLICATION_CREDENTIALS_GRIDFACTORY=
# GOOGLE_APPLICATION_CREDENTIALS_GULF_EL=
#
# Site per brand. Format: sc-domain:gridfactory.io (domain property) OR
# https://gridfactory.io/ (URL-prefix). Must match what is verified in GSC.
GOOGLE_SEARCH_CONSOLE_SITE_GRIDFACTORY=
GOOGLE_SEARCH_CONSOLE_SITE_GULF_EL=
GOOGLE_SEARCH_CONSOLE_SITE=            # generic fallback
#
# OAUTH REFRESH-TOKEN AUTH (durable, reuses an OAuth client you created).
# Client id + secret + a one-time refresh token (webmasters.readonly scope),
# per-brand or shared. Get the refresh token once via Google OAuth Playground
# (gear → use your own client id/secret → authorize Search Console readonly).
GOOGLE_CLIENT_ID_GRIDFACTORY=
GOOGLE_CLIENT_SECRET_GRIDFACTORY=
GOOGLE_REFRESH_TOKEN_GRIDFACTORY=
GOOGLE_CLIENT_ID_GULF_EL=
GOOGLE_CLIENT_SECRET_GULF_EL=
GOOGLE_REFRESH_TOKEN_GULF_EL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# QUICK-TEST AUTH (optional): static OAuth access token (expires ~1h). Service
# account / refresh token above take precedence.
GOOGLE_SEARCH_CONSOLE_TOKEN_GRIDFACTORY=
GOOGLE_SEARCH_CONSOLE_TOKEN_GULF_EL=
GOOGLE_SEARCH_CONSOLE_TOKEN=
GA4_PROPERTY_ID=
