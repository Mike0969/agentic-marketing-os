# =============================================================================
# Agentic OS — environment template (single source of truth)
# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.
# RULE: server-side secrets must NEVER be prefixed NEXT_PUBLIC_ (those ship to the browser).
# Tag legend:  [REQUIRED] app needs it to work   [OPTIONAL] feature-gated / has a default
# =============================================================================

# --- Supabase (auth + database) ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                 # [REQUIRED] Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # [REQUIRED] anon/publishable key (browser-safe)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # [OPTIONAL] alt name for the anon key
SUPABASE_SERVICE_ROLE_KEY=                # [REQUIRED] server-only; lets agent/token-triggered writes bypass RLS. NEVER browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000 # [OPTIONAL] base URL for auth redirects
ADMIN_EMAIL=                              # [OPTIONAL] bootstrap first admin (also add to public.admin_users)

# --- Hermes (primary agent runtime) ------------------------------------------
HERMES_AGENT_ENDPOINT=                    # [REQUIRED for real agents] OpenAI-compatible URL, e.g. http://127.0.0.1:8642/v1/chat/completions (blank = deterministic fallback)
HERMES_AGENT_TOKEN=                       # [OPTIONAL] bearer token if the endpoint requires auth
HERMES_AGENT_MODEL=gpt-5.5                # [OPTIONAL] default model (default gpt-5.5)
HERMES_AGENT_BACKUP_MODEL=                # [OPTIONAL] fallback model on primary failure, e.g. deepseek-v4-flash
HERMES_AGENT_TIMEOUT_MS=120000            # [OPTIONAL] per-call timeout (default 120000)
HERMES_TEAM_PATH=                         # [OPTIONAL] path to team.json (defaults to the buddy profile path)
HERMES_BRAIN_PATH=                        # [OPTIONAL] path to the shared brain dir (defaults from team.json)
AGENT_TRIGGER_TOKEN=                      # [OPTIONAL] bearer token so Hermes/n8n/Telegram can call trigger endpoints without a session
LEAD_FORM_TOKEN=                          # [OPTIONAL] if set, public /api/leads/capture requires this form token

# --- Anthropic / Claude ------------------------------------------------------
ANTHROPIC_API_KEY=                        # [OPTIONAL] enables the Anthropic provider (claude-opus-4 / sonnet-4 / haiku-4)

# --- OpenAI / GPT ------------------------------------------------------------
OPENAI_API_KEY=                           # [OPTIONAL] enables the OpenAI provider + image generation
OPENAI_IMAGE_MODEL=gpt-image-2            # [OPTIONAL] visual asset model (default gpt-image-2)
OPENAI_IMAGE_SIZE=auto                    # [OPTIONAL] image size (default auto)
OPENAI_IMAGE_QUALITY=low                  # [OPTIONAL] image quality (default low)
OPENAI_IMAGE_TIMEOUT_MS=180000            # [OPTIONAL] image timeout (default 180000)

# --- DeepSeek (OpenAI-compatible) --------------------------------------------
DEEPSEEK_API_KEY=                         # [OPTIONAL] enables DeepSeek (deepseek-chat / deepseek-reasoner)
DEEPSEEK_BASE_URL=https://api.deepseek.com # [OPTIONAL] DeepSeek base URL (default https://api.deepseek.com)

# --- GLM / Zhipu AI ----------------------------------------------------------
ZHIPU_API_KEY=                            # [OPTIONAL] enables GLM (glm-4 / glm-4-flash)

# --- Ollama (local models) ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434    # [OPTIONAL] local Ollama server (default http://127.0.0.1:11434)
OLLAMA_DEFAULT_MODEL=                     # [OPTIONAL] default local model name (from `ollama list`)

# --- Telegram (notification channel) -----------------------------------------
TELEGRAM_BOT_TOKEN=                       # [OPTIONAL] bot token from @BotFather
TELEGRAM_CHAT_ID=                         # [OPTIONAL] chat/channel id for alerts

# --- Slack (notification channel) --------------------------------------------
SLACK_BOT_TOKEN=                          # [OPTIONAL] xoxb- bot token
SLACK_CHANNEL_ID=                         # [OPTIONAL] channel id to post reports

# --- Google Search Console (analytics, per brand, read-only) -----------------
# Durable auth (recommended): a service account added as a USER on each GSC property.
GOOGLE_APPLICATION_CREDENTIALS=           # [OPTIONAL] path to service-account JSON key
GOOGLE_SERVICE_ACCOUNT_KEY=               # [OPTIONAL] OR inline service-account JSON (alternative to the path)
GOOGLE_SEARCH_CONSOLE_SITE_GRIDFACTORY=   # [OPTIONAL] e.g. https://gridfactory.io/ or sc-domain:gridfactory.io
GOOGLE_SEARCH_CONSOLE_SITE_GULF_EL=       # [OPTIONAL] e.g. https://www.gulf-el.com/
GOOGLE_SEARCH_CONSOLE_SITE=               # [OPTIONAL] generic site fallback
# OAuth refresh-token auth (alternative, reuses an OAuth client). Per-brand or shared.
GOOGLE_CLIENT_ID=                         # [OPTIONAL] OAuth client id
GOOGLE_CLIENT_SECRET=                     # [OPTIONAL] OAuth client secret
GOOGLE_REFRESH_TOKEN=                     # [OPTIONAL] webmasters.readonly refresh token
# Quick-test only: static OAuth access token (expires ~1h). Service account/refresh preferred.
GOOGLE_SEARCH_CONSOLE_TOKEN=              # [OPTIONAL] short-lived access token for testing
GA4_PROPERTY_ID=                          # [OPTIONAL] planned (GA4 not wired yet)

# --- Automation (optional) ---------------------------------------------------
N8N_WEBHOOK_URL=                          # [OPTIONAL] webhook for external automation

# --- Live posting (controlled) -----------------------------------------------
# Master switch. Posting only fires when this is true AND the operator clicks
# Approve & Post AND the brand has a connected account. Never auto-posts.
SOCIAL_POSTING_ENABLED=false              # [OPTIONAL] default off
# LinkedIn OAuth app (developer.linkedin.com → your app). Add the redirect URL
# to the app's Auth tab (exact match). Products: "Sign In with LinkedIn" +
# "Share on LinkedIn" (w_member_social). localhost is allowed for local testing.
LINKEDIN_CLIENT_ID=                       # [OPTIONAL] LinkedIn app client id
LINKEDIN_CLIENT_SECRET=                   # [OPTIONAL] LinkedIn app client secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
X_CLIENT_ID=                              # [OPTIONAL] X OAuth2 app client id (PKCE; scopes tweet.write users.read offline.access)
X_CLIENT_SECRET=                          # [OPTIONAL] X OAuth2 confidential app secret, if enabled
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback
FACEBOOK_CLIENT_ID=                       # [OPTIONAL] Meta app id for Facebook Page publishing
FACEBOOK_CLIENT_SECRET=                   # [OPTIONAL] Meta app secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
INSTAGRAM_CLIENT_ID=                      # [OPTIONAL] Meta app id for Instagram Graph publishing
INSTAGRAM_CLIENT_SECRET=                  # [OPTIONAL] Meta app secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
TIKTOK_CLIENT_ID=                         # [OPTIONAL] TikTok client key
TIKTOK_CLIENT_SECRET=                     # [OPTIONAL] TikTok client secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback
# Approval friction: Meta Page/Instagram publishing needs App Review for page/IG
# permissions; TikTok Content Posting API is video-only.

# --- Social connectors (legacy scaffolds; superseded by OAuth above) ----------
LINKEDIN_ACCESS_TOKEN=                    # [OPTIONAL] legacy scaffold
X_API_KEY=                                # [OPTIONAL] scaffold
TIKTOK_ACCESS_TOKEN=                      # [OPTIONAL] scaffold
INSTAGRAM_ACCESS_TOKEN=                   # [OPTIONAL] scaffold
FACEBOOK_ACCESS_TOKEN=                    # [OPTIONAL] scaffold
