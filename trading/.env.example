# Trading service configuration. Copy to .env and fill in. Never commit .env.

# --- TradingView MCP --------------------------------------------------------
# Path to the node MCP server (CDP bridge to TradingView Desktop).
TRADING_TV_SERVER_PATH=/Users/dubai/tradingview-mcp/src/server.js
# Broker/exchange prefix used in symbol strings, e.g. "VANTAGE:EURUSD".
# UNVERIFIED: confirm via chart_get_state on the first live run and update.
TRADING_BROKER=VANTAGE
# The MCP drives a CDP connection; TradingView Desktop must be running with
# --remote-debugging-port=9222 (the MCP's tv_launch tool can start it).

# --- Dashboard --------------------------------------------------------------
# Where FastAPI serves the dashboard + WebSocket.
TRADING_HOST=127.0.0.1
TRADING_PORT=8000
# URL the Next.js /trading tab iframes. Default is the FastAPI server above.
TRADING_DASHBOARD_URL=http://127.0.0.1:8000

# --- Storage ----------------------------------------------------------------
TRADING_DB_PATH=trading/data/trading.db

# --- Scanning ---------------------------------------------------------------
# Re-sweep when the primary timeframe (15m) bar closes.
TRADING_POLL_SECONDS=900
# Bars to request per OHLCV pull (MCP caps at 500).
TRADING_OHLCV_BARS=400

# --- Alerts (optional, reused from the marketing OS env) --------------------
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# Optional outbound webhook for state transitions.
# TRADING_WEBHOOK_URL=https://example.com/hook
